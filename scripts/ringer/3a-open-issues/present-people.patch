+def test_present_michelle_is_inserted_after_the_protagonist(monkeypatch):
+    things = _things(_real_prompt(monkeypatch, command="Enter the medical level.", referred=("medical level",)))
+    lines = things.splitlines()
+
+    kristin_index = next(index for index, line in enumerate(lines) if line.startswith("- Kristin."))
+    assert lines[kristin_index + 1].startswith("- ")
+    assert "Michelle" in lines[kristin_index + 1]
+    assert "Place: detention level." in lines[kristin_index + 1]
+    assert sum("Michelle" in line for line in lines) == 1
+    assert not any("senior official" in line.casefold() for line in lines)
+    assert not any("Brandon" in line and "With Kristin" not in line for line in lines)
+
+
+def test_opening_prompt_lists_present_michelle(monkeypatch):
+    things = _things(_real_prompt(monkeypatch))
+
+    assert any("Michelle" in line for line in things.splitlines())
+
+
+def test_command_named_present_person_is_listed_once(monkeypatch):
+    things = _things(_real_prompt(monkeypatch, command="Ask Michelle about the lemon cake.", referred=("Michelle",)))
+
+    assert sum("Michelle" in line for line in things.splitlines()) == 1
+
+
+def test_present_person_line_matches_command_named_person_line(monkeypatch):
+    present = _things(_real_prompt(monkeypatch, command="Enter the medical level.", referred=("medical level",)))
+    named = _things(_real_prompt(monkeypatch, command="Ask Michelle about the lemon cake.", referred=("Michelle",)))
+
+    present_line = next(line for line in present.splitlines() if "Michelle" in line)
+    named_line = next(line for line in named.splitlines() if "Michelle" in line)
+    assert present_line == named_line
+
+
