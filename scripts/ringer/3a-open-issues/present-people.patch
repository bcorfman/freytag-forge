@@ -29,6 +37,58 @@ from storygame.story_package.models import (
     WorldSource,
 )
 
+ROOT = Path(__file__).parents[1]
+PACKAGE = load_story_package(ROOT / "data/stories/continuity-initiative")
+ARRIVED = ("michelle_reached", "uprising_prepared")
+
+
+class _Response:
+    def __init__(self, body: object) -> None:
+        self.body = json.dumps(body).encode()
+
+    def read(self) -> bytes:
+        return self.body
+
+    def __enter__(self) -> _Response:
+        return self
+
+    def __exit__(self, *_args: object) -> bool:
+        return False
+
+
+def _real_prompt(monkeypatch, *, command: str | None = None, referred: tuple[str, ...] = ()) -> str:
+    monkeypatch.setenv("CLOUDFLARE_WORKER_URL", "https://worker.example")
+    state = RuntimeState.bootstrap(PACKAGE)
+    state.current_scene_id = "3A"
+    state.phase = next(scene.metadata.freytag_phase for scene in PACKAGE.scenes if scene.metadata.scene_id == "3A")
+    state._assert_scene_entry_fact("3A")
+    apply_scene_placements(PACKAGE, state.facts, "3A")
+    if command is not None:
+        for fact_id in ARRIVED:
+            state.facts.assert_fact(Fact(predicate=fact_id, subject="story", value="true"))
+    captured: list[dict[str, object]] = []
+
+    def open_request(request, **_kwargs: object) -> _Response:
+        payload = json.loads(request.data)
+        captured.append(payload)
+        if payload["system"].startswith("You match names in a story game"):
+            return _Response({"refers": list(referred), "same_as": {}})
+        return _Response({"narration": json.dumps({"segments": [{"kind": "narration", "text": "Fixture."}]})})
+
+    monkeypatch.setattr(cloudflare, "urlopen", open_request)
+    provider = build_capture_provider(state)
+    if command is None:
+        provider.opening()
+        return captured[-1]["user"]
+    else:
+        provider.prepare_turn(command)
+        prompt = provider.assemble_turn_prompt(command)
+        return provider._section_user_prompt(prompt["context"])
+
+
+def _things(prompt: str) -> str:
+    return prompt.split("THINGS:\n", 1)[1].split("\n\n", 1)[0]
+
 
