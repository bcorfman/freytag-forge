{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freytag-demo-narrate",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "DAILY_BUDGET", "class_name": "DailyBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }]
}
