{
  "schema_version": "causal-compiler-phase0-fixtures-v1",
  "namespaces": {
    "truth": ["opening", "failure", "constraint", "remedy", "tradeoff"],
    "participant": ["engineer"],
    "location": ["dock", "relay"],
    "connected_route": ["dock_relay"],
    "causal_event": ["failure_event", "repair_event"],
    "evidence_opportunity": ["scan", "log", "repair_log", "crew_testimony"],
    "realization_route": ["diagnose_scan", "diagnose_log", "commit", "commit_testimony"],
    "revelation": ["diagnose", "commit"],
    "required_outcome": ["survive"],
    "required_beat": ["setup", "rise", "crisis", "climax", "resolution"]
  },
  "cases": {
    "known": {
      "reference": "diagnose_scan",
      "namespace": "realization_route",
      "expected_code": null
    },
    "wrong_namespace": {
      "field": "evidence_opportunities[0].holder_id",
      "reference": "dock",
      "supplied_namespace": "location",
      "expected_namespace": "participant",
      "expected_code": "UNKNOWN_REFERENCE"
    },
    "ambiguous": {
      "reference": "shared",
      "matching_namespaces": ["truth", "participant"],
      "expected_code": "AMBIGUOUS_REFERENCE"
    },
    "multiple_errors": {
      "fields": [
        "evidence_opportunities[0].route_id",
        "evidence_opportunities[1].route_id"
      ],
      "expected_code": "UNKNOWN_REFERENCE",
      "expected_detail": "invalid opportunity references: scan.route_id->missing_scan_route, log.route_id->missing_log_route"
    }
  }
}
